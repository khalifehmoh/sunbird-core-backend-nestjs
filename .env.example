# Copied to .env by `npm run setup`. JWT_SECRET is generated automatically.
NODE_ENV=development
PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sunbird_core_db
DB_USERNAME=sunbird_app
DB_PASSWORD=sunbird_local_password
# Only needed for a local (non-Docker) Postgres that does not yet have sunbird_app.
# DB_ADMIN_USERNAME=postgres
# DB_ADMIN_PASSWORD=change-me
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_TOKEN_EXPIRY_MS=900000
JWT_REFRESH_TOKEN_EXPIRY_MS=604800000
JWT_REMEMBER_ME_REFRESH_TOKEN_EXPIRY_MS=2592000000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
