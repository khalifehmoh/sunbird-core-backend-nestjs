# Copied to .env by `npm run setup`. JWT_SECRET is generated automatically.
NODE_ENV=development
PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sunbird_core_db
DB_USERNAME=sunbird_app
DB_PASSWORD=sunbird_local_password
# Only needed for a local (non-Docker) Postgres that does not yet have sunbird_app.
# DB_ADMIN_USERNAME=postgres
# DB_ADMIN_PASSWORD=change-me
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ACCESS_TOKEN_EXPIRY_MS=900000
JWT_REFRESH_TOKEN_EXPIRY_MS=604800000
JWT_REMEMBER_ME_REFRESH_TOKEN_EXPIRY_MS=2592000000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Medplum FHIR engine. Internal only: the browser never talks to Medplum, it
# reaches FHIR through this API under /api/v1/fhir. Run `npm run medplum:up` to
# start the containers and provision the values below.
# Local-dev credentials, safe to commit; regenerate for any shared environment.
MEDPLUM_ENABLED=false
MEDPLUM_BASE_URL=http://localhost:8103/
MEDPLUM_TENANTS_FILE=.medplum/tenants.json

# HL7 v2 inbound for an integration engine: POST /api/v1/emr/integration/inbound
# with headers X-Integration-Key (this value) and X-Tenant-Id. Min 24 characters.
# Unset disables the endpoint.
# INTEGRATION_API_KEY=

# Event-driven spike (Medplum Bot vs BullMQ on Medplum Redis). No Kafka.
# `npm run medplum:events` provisions the Bot + Subscriptions.
EVENTS_ENABLED=false
EVENTS_SUBSCRIPTION_SECRET=local-subscription-secret-change-me
EVENTS_REDIS_HOST=localhost
EVENTS_REDIS_PORT=6380
# Defaults to MEDPLUM_REDIS_PASSWORD / medplum_local_password when omitted.
# EVENTS_REDIS_PASSWORD=
